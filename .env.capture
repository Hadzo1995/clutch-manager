# Capture builds for marketing footage (npm run capture / capture:dev). Not secret.
# Shows only the game's own content: demo players, no real photos or team logos.
VITE_CAPTURE=1
# Empty on purpose: capture builds stay offline (no sign-in, no beta gate, no cloud saves),
# even when .env.local has the Supabase values for development.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
